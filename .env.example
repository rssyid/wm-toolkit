# ==============================================================================
# WM-Toolkit Environment Variables Template (.env.example)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Database Configuration (Neon PostgreSQL)
# ------------------------------------------------------------------------------
# Gunakan connection string dengan pooled connection (-pooler) untuk Serverless / Vercel
DATABASE_URL="postgresql://[USER]:[PASSWORD]@[ENDPOINT]-pooler.[REGION].aws.neon.tech/neondb?sslmode=require"

# (Opsional) Direct connection string untuk migrasi schema berat
DIRECT_URL="postgresql://[USER]:[PASSWORD]@[ENDPOINT].[REGION].aws.neon.tech/neondb?sslmode=require"

# ------------------------------------------------------------------------------
# 2. NextAuth.js / Auth.js Credentials Configuration
# ------------------------------------------------------------------------------
# Buat string random dengan: openssl rand -base64 32
NEXTAUTH_SECRET="your_nextauth_secret_key_minimum_32_characters_random"
NEXTAUTH_URL="http://localhost:3000"

# ------------------------------------------------------------------------------
# 3. Google Drive API Integration (Service Account)
# ------------------------------------------------------------------------------
# Email Service Account dari Google Cloud Console
GOOGLE_SERVICE_ACCOUNT_EMAIL="wm-toolkit-drive-service@[PROJECT-ID].iam.gserviceaccount.com"

# Private key Service Account (jika multiline, gunakan newline escaping \n)
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkqhkiG9w0BAQEFAASCBKgwggSkAgEAAoIBAQC...\n-----END PRIVATE KEY-----\n"

# ID Folder Google Drive tempat menyimpan berkas dan lampiran bukti SAP
GOOGLE_DRIVE_FOLDER_ID="1A2B3C4D5E6F7G8H9I0J_kLmNoPqRsTuV"
